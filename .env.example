# ---- database ------------------------------------------------------
# Two connection strings, and the difference matters.
#
# DATABASE_URL      the OWNER role. Migrations and seed only. Row level
#                   security does not apply to a table's owner, so the app
#                   must never run on this.
# APP_DATABASE_URL  the least-privilege `module_risk_app` role the app runs
#                   on. RLS applies, and it cannot read password hashes.
#
# APP_DATABASE_URL is OPTIONAL. Left unset, it is derived from DATABASE_URL:
# same host and database, the app role, and a password computed from the
# owner's. The deploy applies that same password to the role, so the two
# agree without either one storing it. Set it only to override — and never
# to the owner role, which is the one mistake with no symptom.
#
# Neon shape — see docs/neon-and-vercel.md. `pgbouncer=true` is added to
# pooled hosts and `channel_binding` is stripped automatically, so a string
# pasted straight from Neon works as-is.
DATABASE_URL="postgresql://neondb_owner:pw@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:pw@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# APP_DATABASE_URL="postgresql://module_risk_app:pw@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- auth ----------------------------------------------------------
# The one secret this app will not invent for you. It signs session cookies,
# and keeping it independent of the database password means a leaked database
# credential cannot also be used to forge sessions.
#   openssl rand -base64 32
AUTH_SECRET="generate-a-secret"
# Only needed if the deployment URL cannot be inferred (Vercel sets it).
# AUTH_URL="https://your-app.vercel.app"

# ---- photo evidence ------------------------------------------------
# Vercel Blob. Storage → Blob → connect, then pull with `vercel env pull`.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ---- seed ----------------------------------------------------------
# Password given to the three demo accounts. Set something else, or remove
# the demo block from prisma/seed.ts before seeding production.
# SEED_PASSWORD="risk-demo-1234"

# ---- PDF -----------------------------------------------------------
# Points the PDF renderer at a local Chromium instead of the serverless
# build. Unset on Vercel, where @sparticuz/chromium is used.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
